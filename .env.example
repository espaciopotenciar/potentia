# Copiar este archivo a .env.local (NO subir .env.local a GitHub) y completar
# con los valores reales. .env.local ya está listado en .gitignore.
#
# Reglas:
# - Las variables NEXT_PUBLIC_* quedan visibles en el navegador: solo deben
#   usarse para datos que ya son públicos por diseño (URL del proyecto,
#   clave publishable de Supabase, URL pública del sitio).
# - SUPABASE_SECRET_KEY (o cualquier otra clave administrativa/service role)
#   NUNCA debe tener el prefijo NEXT_PUBLIC_, nunca debe imprimirse en
#   consola, y nunca debe cargarse en un componente cliente. Solo se lee
#   desde código que corre exclusivamente en el servidor (Route Handler,
#   Server Action o función administrativa).
# - Ninguna variable de este archivo tiene un valor real cargado. Los
#   valores reales viven únicamente en .env.local (local) y en la
#   configuración de variables de entorno del hosting (producción).

# URL del proyecto Supabase. Pública.
NEXT_PUBLIC_SUPABASE_URL=

# Clave "publishable" de Supabase (apta para el navegador). Pública.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clave administrativa / service role de Supabase. PRIVADA.
# Nunca con prefijo NEXT_PUBLIC_. Nunca en el navegador. Nunca en GitHub.
SUPABASE_SECRET_KEY=

# URL pública de producción de la aplicación (usada por ejemplo para
# construir enlaces de recuperación de contraseña / invitación).
NEXT_PUBLIC_SITE_URL=
